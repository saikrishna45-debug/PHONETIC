# Environment Variables Template for PHONETIC

# Frontend (Next.js)
NEXT_PUBLIC_APP_NAME="PHONETIC"
NEXT_PUBLIC_API_URL="http://localhost:8000/api"

# Backend (FastAPI)
ENVIRONMENT="development"
PROJECT_NAME="PHONETIC Backend"
SECRET_KEY="your-super-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL)
DATABASE_URL="postgresql+psycopg://postgres:your_password@localhost:5432/phonetic"

# ML Model Paths
RESALE_MODEL_PATH="ml/models/resale/resale_model.joblib"
RECOMMENDATION_MODEL_PATH="ml/models/recommendation/recommendation_model.joblib"
